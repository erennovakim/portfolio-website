{
  "design_system_name": "Art Course Web Platform Design System",
  "version": "1.1.0",
  "description": "Comprehensive design system containing style tokens, color palettes, typography rules, and interactive component definitions. Extended with Eren Nova Kim portfolio components.",
  "global_tokens": {
    "colors": {
      "primary": {
        "hex": "#bf2f1f",
        "name": "Terracotta Red",
        "usage": "Primary CTA buttons, highlighted sections, feature accents, active tags"
      },
      "secondary": {
        "hex": "#4a4845",
        "name": "Charcoal Grey",
        "usage": "Subtitles, body copy text, collapsed accordion borders, metadata icons"
      },
      "neutral_dark": {
        "hex": "#000000",
        "name": "Pure Black",
        "usage": "Primary titles, dark container backgrounds, footer text/bg"
      },
      "neutral_light": {
        "hex": "#f8f1e6",
        "name": "Alabaster Cream",
        "usage": "Global canvas/page background color, light card surface accents"
      },
      "white": {
        "hex": "#ffffff",
        "name": "Pure White",
        "usage": "Text overlays on dark or primary backgrounds, primary button text labels, floating nav surface"
      },
      "placeholder_grey": {
        "hex": "#d5d5d5",
        "name": "D5 Grey",
        "usage": "Filler image blocks for work cards, hero, and about sections"
      }
    },
    "typography": {
      "font_family": {
        "heading": "Libre Baskerville, Baskerville, URW Bookman L, Times New Roman, serif",
        "body": "Open Sans, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif"
      },
      "font_weights": {
        "regular": "400",
        "medium": "500",
        "max_allowed": "500",
        "note": "No text weight may exceed medium (500)."
      },
      "font_sizes": {
        "xs": "12px",
        "sm": "14px",
        "base": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "32px",
        "4xl": "48px",
        "5xl": "64px"
      },
      "line_heights": {
        "tight": "1.1",
        "snug": "1.3",
        "normal": "1.5",
        "relaxed": "1.6"
      }
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "2xl": "48px",
      "3xl": "64px",
      "4xl": "96px",
      "page_gutter": "32px"
    },
    "borders": {
      "radius": {
        "none": "0px",
        "sm": "4px",
        "md": "8px",
        "lg": "16px",
        "pill": "9999px",
        "nav": "28px"
      },
      "widths": {
        "thin": "1px",
        "medium": "2px"
      }
    }
  },
  "components": {
    "navigation_bar": {
      "description": "Top persistent header layer providing brand presentation and primary page navigation anchors.",
      "background_color": "transparent",
      "height": "80px",
      "layout": "flex-row-space-between",
      "branding": {
        "text": "ART course",
        "font_weight": "500",
        "font_size": "20px",
        "color": "#000000"
      },
      "nav_links": {
        "items": ["Features", "About us", "How it works", "Testimonials", "News"],
        "font_size": "14px",
        "font_weight": "500",
        "color": "#4a4845",
        "spacing": "24px"
      },
      "cta": {
        "text": "Get Started",
        "style_variant": "buttons.primary"
      }
    },
    "floating_navbar": {
      "description": "Sticky, top-centered floating navigation pill for the portfolio site.",
      "position": "fixed-top-center",
      "top_offset": "24px",
      "z_index": 100,
      "background_color": "rgba(255, 255, 255, 0.92)",
      "backdrop_filter": "blur(12px)",
      "border_radius": "28px",
      "padding_y": "14px",
      "padding_x": "24px",
      "width": "fit-content",
      "box_shadow": "0 4px 24px rgba(0, 0, 0, 0.08)",
      "branding": {
        "text": "Eren Nova Kim",
        "href": "index.html#top",
        "font_family": "Libre Baskerville",
        "font_size": "18px",
        "font_weight": "500",
        "color": "#000000",
        "gap_to_links": "40px"
      },
      "nav_links": {
        "items": ["Home", "Work", "About", "Resume"],
        "font_family": "Open Sans",
        "font_size": "16px",
        "font_weight": "500",
        "line_height": "1",
        "color": "#4a4845",
        "hover_color": "#000000",
        "active_color": "#bf2f1f",
        "spacing": "24px"
      },
      "dropdown": {
        "trigger": "Work",
        "trigger_href": "#work",
        "items": [
          { "label": "Work 1", "href": "work1.html" },
          { "label": "Work 2", "href": "work2.html" },
          { "label": "Work 3", "href": "work3.html" },
          { "label": "Work 4", "href": "work4.html" }
        ],
        "background_color": "#ffffff",
        "border_radius": "8px",
        "padding": "8px 0",
        "item_font_size": "14px",
        "item_font_weight": "500",
        "item_color": "#4a4845",
        "item_hover_background": "#f8f1e6"
      },
      "resume_link": {
        "href": "assets/resume/Eren Nova Kim - Resume.pdf",
        "target": "_blank",
        "rel": "noopener noreferrer"
      },
      "mobile": {
        "breakpoint": "768px",
        "border_radius_max": "28px",
        "menu_style": "compact-fit-content-collapsed",
        "menu_width_open": "min(calc(100vw - 2rem), 16rem)"
      }
    },
    "buttons": {
      "primary": {
        "description": "High-emphasis action indicator used for conversion funnels and key discovery modules.",
        "background_color": "#bf2f1f",
        "text_color": "#ffffff",
        "font_size": "14px",
        "font_weight": "500",
        "padding": "12px 24px",
        "border_radius": "9999px",
        "text_transform": "none"
      }
    },
    "portfolio_hero": {
      "description": "Personal introduction hero for Eren Nova Kim portfolio homepage.",
      "layout": {
        "desktop": "2-column-text-left-image-right",
        "desktop_columns": "2fr 1fr",
        "mobile": "stacked",
        "breakpoint": "768px"
      },
      "background_color": "#f8f1e6",
      "padding_y": "96px",
      "padding_top_extra": "120px",
      "intro": {
        "text": "hello, my name is",
        "font_family": "Open Sans",
        "font_size": "24px",
        "font_weight": "400",
        "color": "#4a4845",
        "margin_bottom": "8px",
        "serif_words": ["hello,"],
        "serif_font_style": "italic"
      },
      "name": {
        "text": "Eren Nova Kim,",
        "font_family": "Libre Baskerville",
        "font_size": "64px",
        "font_weight": "500",
        "color": "#000000",
        "line_height": "1.1",
        "margin_bottom": "16px"
      },
      "tagline": {
        "text": "a product designer driven by research and a background in development.",
        "font_family": "Open Sans",
        "font_size": "24px",
        "font_weight": "400",
        "color": "#4a4845",
        "max_width": "576px",
        "line_height": "1.5",
        "serif_words": ["research", "development"],
        "serif_font_style": "italic"
      },
      "image": {
        "type": "placeholder",
        "background_color": "#d5d5d5",
        "width_ratio": "one-third",
        "height_behavior": "match_text_height"
      }
    },
    "work_grid_section": {
      "description": "Portfolio work showcase with linked image cards in a responsive 2x2 grid.",
      "section_id": "work",
      "section_title": {
        "text": "Work",
        "font_size": "32px",
        "font_weight": "500",
        "color": "#000000",
        "margin_bottom": "48px"
      },
      "layout": {
        "desktop": "2-column-grid",
        "mobile": "1-column-stack",
        "gap": "24px",
        "breakpoint": "768px"
      },
      "work_card": {
        "description": "Clickable project card with image and title linking to individual work pages.",
        "border_radius": "0px",
        "image_aspect_ratio": "4/3",
        "image_background_color": "#d5d5d5",
        "title_font_family": "Open Sans",
        "title_font_size": "20px",
        "title_font_weight": "500",
        "title_color": "#000000",
        "title_margin_top": "16px",
        "hover_transform": "translateY(-4px)",
        "hover_shadow": "0 8px 32px rgba(0, 0, 0, 0.1)",
        "transition": "transform 0.2s ease, box-shadow 0.2s ease",
        "content_data": [
          { "title": "Work 1", "href": "work1.html", "image_seed": "work1" },
          { "title": "Work 2", "href": "work2.html", "image_seed": "work2" },
          { "title": "Work 3", "href": "work3.html", "image_seed": "work3" },
          { "title": "Work 4", "href": "work4.html", "image_seed": "work4" }
        ]
      }
    },
    "about_split_section": {
      "description": "About section with body copy and portrait/image in a side-by-side layout.",
      "section_id": "about",
      "section_title": {
        "text": "About",
        "font_size": "32px",
        "font_weight": "500",
        "color": "#000000",
        "margin_bottom": "48px"
      },
      "layout": {
        "desktop": "2-column-split",
        "desktop_columns": "2fr 1fr",
        "mobile": "stacked",
        "gap": "48px",
        "breakpoint": "768px"
      },
      "body_text": {
        "font_size": "16px",
        "font_weight": "400",
        "color": "#4a4845",
        "line_height": "1.6"
      },
      "image": {
        "type": "placeholder",
        "background_color": "#d5d5d5",
        "border_radius": "0px",
        "height_behavior": "match_text_height"
      }
    },
    "portfolio_footer": {
      "description": "Site footer with attribution and social icon links.",
      "background_color": "#000000",
      "padding_y": "48px",
      "padding_x": "64px",
      "layout": "flex-column-center",
      "attribution": {
        "text": "Made using Cursor and code by Eren Nova Kim",
        "font_size": "14px",
        "font_weight": "400",
        "color": "#ffffff",
        "margin_bottom": "24px"
      },
      "social_links": {
        "icon_color": "#ffffff",
        "icon_size": "24px",
        "spacing": "24px",
        "hover_color": "#bf2f1f",
        "platforms": [
          { "name": "LinkedIn", "icon": "linkedin", "href": "https://www.linkedin.com/in/eren-kim/" },
          { "name": "GitHub", "icon": "github", "href": "https://github.com/erennovakim" },
          { "name": "Email", "icon": "email", "href": "mailto:eren.novakim@gmail.com" }
        ]
      }
    },
    "hero_section": {
      "description": "Introduces the main platform value proposition wrapped inside an asymmetrical layout with scattered artwork modules.",
      "layout": "centered-text-block-with-floating-masonry-images",
      "background_color": "#f8f1e6",
      "padding_y": "96px",
      "title": {
        "text": "DISCOVER THE ARTIST WITHIN YOU",
        "font_size": "64px",
        "font_weight": "500",
        "color": "#000000",
        "text_transform": "uppercase",
        "margin_bottom": "24px"
      },
      "subtitle": {
        "text": "Learn, explore, and test your knowledge of art through interactive lessons and quizzes.",
        "font_size": "16px",
        "font_weight": "400",
        "color": "#4a4845",
        "max_width": "600px",
        "margin_bottom": "0px"
      },
      "artwork_placeholders": {
        "description": "Asymmetrical float layout containing iconic classical and modern art thumbnails with hard square edges.",
        "border_radius": "0px"
      }
    },
    "features_grid_section": {
      "description": "Three-column grid showcasing functional highlights of the learning solution.",
      "section_title": {
        "text": "WHY CHOOSE ART COURSE?",
        "font_size": "32px",
        "font_weight": "500",
        "color": "#000000",
        "margin_bottom": "48px"
      },
      "layout": "3-column-grid",
      "card_schema": {
        "icon_type": "line-art-minimalist-glyphs",
        "title_font_size": "18px",
        "title_font_weight": "500",
        "title_color": "#000000",
        "body_font_size": "14px",
        "body_color": "#4a4845",
        "spacing_gap": "16px"
      }
    },
    "product_promo_split": {
      "description": "Dark thematic feature section contrasting platform values against native interface app mockups.",
      "background_color": "#000000",
      "padding": "64px",
      "layout": "2-column-asymmetric-split"
    },
    "testimonials_section": {
      "description": "Social proof segment highlighting multi-column student success metrics and quotes.",
      "section_title": {
        "text": "WHAT USERS SAY",
        "font_size": "24px",
        "font_weight": "500",
        "color": "#000000"
      },
      "layout": "3-column-horizontal-row"
    },
    "cross_platform_promo": {
      "description": "High impact callout band driving visibility to multi-device syncing capabilities.",
      "background_color": "#bf2f1f",
      "text_color": "#ffffff",
      "padding": "64px",
      "alignment": "centered"
    },
    "faq_accordion": {
      "description": "Clean, understated vertical collapsible drawers split by thin rule line dividers.",
      "section_title": {
        "text": "FAQ",
        "font_size": "32px",
        "font_weight": "500",
        "color": "#000000"
      }
    },
    "blog_grid": {
      "description": "Editorial 2-column list view presenting contextual card panels with categorizing tags and author details.",
      "section_title": {
        "text": "BLOG",
        "font_size": "32px",
        "font_weight": "500",
        "color": "#000000",
        "margin_bottom": "32px"
      }
    },
    "footer": {
      "description": "Grounding dark utility block housing explicit page indexes and social compliance paths.",
      "background_color": "#000000",
      "padding_y": "48px",
      "padding_x": "64px",
      "layout": "flex-row-space-between-align-center",
      "branding": {
        "text": "ART course",
        "font_size": "16px",
        "font_weight": "500",
        "color": "#ffffff"
      },
      "navigation": {
        "items": ["Features", "About us", "How it works", "Testimonials", "News"],
        "font_size": "14px",
        "font_weight": "400",
        "color": "#ffffff",
        "spacing": "20px"
      },
      "social_channels": {
        "platforms": ["tiktok", "instagram", "youtube"],
        "icon_color": "#ffffff",
        "spacing": "16px"
      }
    }
  }
}
